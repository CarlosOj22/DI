<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoWeather.Vistas.PaginaBusqueda"
             Title="PaginaBusqueda">
    <Grid>
        <Entry x:Name="poblacion"  VerticalOptions="Start" HorizontalOptions="Start" Margin="20,20,0,0" WidthRequest="140" HeightRequest="25"/>
        <Button Text="Buscar" VerticalOptions="Start" HorizontalOptions="Start" Margin="170,20,0,0" WidthRequest="140" HeightRequest="25" Clicked="Button_Clicked"/>
        <Picker x:Name="lista" VerticalOptions="Start" HorizontalOptions="Start" Margin="20,70,0,0" WidthRequest="140" HeightRequest="25" SelectedIndexChanged="lista_SelectedIndexChanged"/>
        <Entry x:Name="lat" VerticalOptions="Start" HorizontalOptions="Start" Margin="330,20,0,0" WidthRequest="140" HeightRequest="25"/>
        <Entry x:Name="lon" VerticalOptions="Start" HorizontalOptions="Start" Margin="330,70,0,0" WidthRequest="140" HeightRequest="25"/>
        <Button Text="Calcular" VerticalOptions="Start" HorizontalOptions="Start" Margin="500,20,0,0" WidthRequest="140" HeightRequest="25" Clicked="Button_Clicked_1"/>
        <!-- <Entry x:Name="tiempo" VerticalOptions="Start" HorizontalOptions="Start" Margin="330,120,0,0" WidthRequest="500" HeightRequest="300"/> -->
        <StackLayout Margin="330,120,0,0" WidthRequest="500" Spacing="10">
            <Image x:Name="iconoClima" WidthRequest="100" HeightRequest="100" HorizontalOptions="Start"/>
            <Label x:Name="tiempo" FontSize="16" LineBreakMode="WordWrap"/>
        </StackLayout>
    </Grid>
</ContentPage>