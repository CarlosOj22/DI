<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProyectoWeather.Vistas.Bienvenidad"
             Title="Bienvenidad">
    <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center">
        <Label Text="e-mail" />
        <Entry x:Name="txtEmail" WidthRequest="100"></Entry>
        <Label Text="Password" />
        <Entry x:Name="txtPass" WidthRequest="100" IsPassword="True"></Entry>
        <Button Text="Conectar" Clicked="Button_Clicked"></Button>
    </VerticalStackLayout>
</ContentPage>