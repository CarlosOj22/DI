<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PrimeraAplicacion.Vista.TextControlsDemo"
             Title="TextControlsDemo">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Button x:Name="btnTest" WidthRequest="200" HorizontalOptions="Center" Text="Click Me!" Clicked="btnTest_Clicked"/>


        <Label Text="Selecciona esta opcion para continuar"/>
        <HorizontalStackLayout>
            <CheckBox x:Name="chkEstado" IsChecked="True" CheckedChanged="CheckBox_CheckedChanged"/>
            <Label x:Name="lblChk"  Text="" VerticalTextAlignment="Center"/>
        </HorizontalStackLayout>

        <Slider x:Name="slider"
    WidthRequest="200"
    Minimum="0"
    Maximum="10"
    MinimumTrackColor="Yellow"
    MaximumTrackColor="Green"
    ThumbColor="DarkRed"
    ValueChanged="slider_ValueChanged">
        </Slider>
        <Label x:Name="lblSlider"/>


        <Stepper x:Name="stepper"
    Maximum="10"
    Minimum="0"
    Increment="2"
    ValueChanged="stepper_ValueChanged"      
          />


        <Switch IsToggled="True" Toggled="Switch_Toggled"/>


        <DatePicker x:Name="fecha" DateSelected="fecha_DateSelected"/>


        <TimePicker/>
        <HorizontalStackLayout>
            <VerticalStackLayout>
                <RadioButton
        IsChecked="True"
        Content="Masculino"
        GroupName="grupo1"
        />
                <RadioButton
        Content="Femenido"
        GroupName="grupo1"
        />
                <RadioButton
        Content="Otros"
        GroupName="grupo1"
        />
            </VerticalStackLayout>
            <VerticalStackLayout>
                <RadioButton
        Content="Soltero"
        GroupName="grupo2"
        />
                <RadioButton
        IsChecked="True"
        Content="Casado"
        GroupName="grupo2"
        />
            </VerticalStackLayout>
        </HorizontalStackLayout>
        <Entry Placeholder="Name"
            x:Name="txtName"
            PlaceholderColor="DarkGreen" 
            TextChanged="txtName_TextChanged"   
            Completed="txtName_Completed"
            />
        <!--IsPassword="True"-->
        <!--Keyboard="Telephone"-->

        <Editor AutoSize="TextChanges"/>
        <HorizontalStackLayout>
            <CheckBox x:Name="chkEjecucion" IsChecked="False"/>
            <Label VerticalTextAlignment="Center" Text="Ejecutar aplicación en segundo Plano"></Label>
        </HorizontalStackLayout>

        <ActivityIndicator x:Name="iconoActividad" IsRunning="False"/>

        <Button Text="Pulsame" Clicked="Button_Clicked"/>

        <ProgressBar x:Name="barraProgeso" />
        
        <Entry 
     x:Name="txtNuevoElementoLista"
     Completed="txtNuevoElementoLista_Completed"
     />
        <Picker x:Name="picker" Margin="100,10,100,0"
         Title="Selecciona un elemento de la lista de la compra">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Aguas</x:String>
                    <x:String>Leche</x:String>
                    <x:String>Azúcar</x:String>
                    <x:String>Sal</x:String>
                    <x:String>Aceite</x:String>
                    <x:String>Pan</x:String>
                    <x:String>Huevos</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>
    </VerticalStackLayout>
</ContentPage>